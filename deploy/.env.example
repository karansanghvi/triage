# The server's .env for docker-compose.yml (copy to .env in the repo folder on the server; never commit it).
# Names only: what each one is, its format and how to generate the secrets are in DEPLOY.md, section 4.
# TRIAGE_TRUSTED_PROXY_HOPS is set in docker-compose.yml, not here.

# ---------- Image tags: written by deploy/update.sh and deploy/rollback.sh; leave empty ----------
TRIAGE_IMAGE_TAG=
TRIAGE_PREVIOUS_IMAGE_TAG=
# Where images come from. Empty: ghcr.io/karansanghvi/triage-api (built by GitHub Actions); a fork sets its own
TRIAGE_IMAGE_REPO=

# ---------- Caddy (HTTPS) ----------
API_DOMAIN=
ACME_EMAIL=

# ---------- Database (Neon) ----------
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TRIAGE_DB_PREPARED_STATEMENTS=

# ---------- Secrets: generate fresh for production ----------
TRIAGE_HASH_SECRET=
TRIAGE_ENCRYPTION_KEYS=
TRIAGE_API_KEYS=
TRIAGE_ADMIN_KEYS=

# ---------- Providers ----------
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------- Public website, accounts and email ----------
TRIAGE_PUBLIC=
TRIAGE_ACCOUNTS=
TRIAGE_CORS_ORIGINS=
TRIAGE_APP_URL=
TRIAGE_PUBLIC_API_URL=
RESEND_API_KEY=
TRIAGE_EMAIL_FROM=
TRIAGE_EMAIL_LOGO_URL=

# ---------- Host size ----------
# The API container's memory cap. Empty: 1536m (a 3 GB VM, e.g. Oracle A1). A 1 GB VM (Google Cloud e2-micro): 640m
TRIAGE_API_MEM_LIMIT=

# ---------- Optional tuning (empty: the defaults, which are right for production) ----------
TRIAGE_REQUEST_LOG_RETENTION_DAYS=
TRIAGE_PUBLIC_STATS_MIN_REQUESTS=
TRIAGE_KEYLESS_LOOKUP_MINUTES=

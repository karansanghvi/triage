# Secrets: never commit these
.env

# Virtual environment
venv/

# Saved API responses (can be large, and may contain your prompts)
data/cache/

# Python junk
__pycache__/
*.pyc

# Editor and OS files
.vscode/
.DS_Store
# Arena review files (regenerated by eval.benchmarks arena-candidates)
data/benchmarks/arena_candidates.jsonl
data/benchmarks/arena_review.txt
data/benchmarks/arena_excluded.jsonl

# Pilot runs of the data collection (not committed)
data/pilot/
data/pilot2/

# Judge plumbing test output (not committed)
data/judge_test/

# LLM judgments (not committed)
data/judgments/

# Collected answers, run logs and state (large; not committed)
data/answers/

# Scores and outcomes (rebuilt from answers and judgments by eval.score_answers / eval.build_outcomes)
data/scores.jsonl
data/scores_review.txt
data/outcomes.jsonl

# Router inputs (rebuilt by app.router.features / app.router.embeddings)
data/features.npz
data/features_guessed.npz
data/embeddings.npz

# Judge calibration output (judge verdicts on exact-match answers; not committed)
data/judge_calibration/

# Trained model files (rebuilt by eval.train_classifier); the .json metrics next to them are committed
models/*.joblib

# Request logs from the API (SQLite; no keys or text, but per-request data)
data/logs/

# Calibration run locks (temporary; not committed)
data/checker_calibration/*.pid
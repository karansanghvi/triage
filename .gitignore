# Secrets: never commit these
.env

# Virtual environment
venv/

# Saved API responses (can be large, and may contain your prompts)
data/cache/

# Python junk
__pycache__/
*.pyc

# Editor and OS files
.vscode/
.DS_Store
# Arena review files (regenerated by eval.benchmarks arena-candidates)
data/benchmarks/arena_candidates.jsonl
data/benchmarks/arena_review.txt
data/benchmarks/arena_excluded.jsonl

# Pilot runs of the data collection (not committed)
data/pilot/
data/pilot2/

# Judge plumbing test output (not committed)
data/judge_test/

# LLM judgments (not committed)
data/judgments/

# Collected answers, run logs and state (large; not committed)
data/answers/

# Scores and outcomes (rebuilt from answers and judgments by eval.score_answers / eval.build_outcomes)
data/scores.jsonl
data/scores_review.txt
data/outcomes.jsonl

# Router inputs (rebuilt by app.router.features / app.router.embeddings)
data/features.npz
data/features_guessed.npz
data/embeddings.npz

# Judge calibration output (judge verdicts on exact-match answers; not committed)
data/judge_calibration/

# Trained model files (rebuilt by eval.train_classifier); the .json metrics next to them are committed
models/*.joblib
# ...except the live classifier's (config/routing.yaml): the server needs them and they can't be rebuilt without
# the git-ignored training data. Their .npz exports (numpy, used by the server) are committed too.
!models/classifier_c_logreg_cv_low_v2.joblib
!models/classifier_c_logreg_cv_medium_v2.joblib

# Request logs from the API (SQLite; no keys or text, but per-request data)
data/logs/
# The local database (app/db.py): request log, later accounts. SQLite plus its -wal/-shm files
data/triage.sqlite3*
data/fake.sqlite3*

# Calibration run locks (temporary; not committed)
data/checker_calibration/*.pid

data/checker_val/*.pid

data/checker_test/*.pid
# Demo usage counters (Phase 5)
data/demo/

# Design mock-ups used while building the web app (kept locally, not published)
web/design-refs/

# The embedding model, downloaded by the deploy build (scripts/fetch_embedding_model.py, HF_HOME=.hf-cache)
.hf-cache/

# Written when the Docker image is built (app/db.py, SCHEMA_HEAD_FILE)
migrations/HEAD

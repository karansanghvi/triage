# Triage configuration. Copy to .env (never commit .env) and fill in what you need.
# Secrets are left empty on purpose: the server refuses to start rather than run with a guessable value.
# Generate secrets with the commands given below.

# ---------- Provider keys (the server's own; used only for providers in server_providers) ----------
# Free tiers: what the free demo and Triage-key requests use
GROQ_API_KEY=
GEMINI_API_KEY=
# Only for the data-collection scripts and scripts/check_setup.py (no live model uses OpenRouter)
OPENROUTER_API_KEY=
# Paid providers: only for benchmarks; live routing uses them only with a user's own key (BYOK or an account)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# A local Ollama server (the low tier's ollama-llama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Triage keys and secrets ----------
# Bearer keys for your own apps (comma-separated). Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRIAGE_API_KEYS=
# Keys that may also read and change the live routing config (/v1/routing-config). Same generator
TRIAGE_ADMIN_KEYS=
# Keys the prompt HMACs, cache fingerprints, visitor ids and account API key hashes. Required with the database log.
# Changing it invalidates every account API key (see README). Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
TRIAGE_HASH_SECRET=

# ---------- Database ----------
# Request log, demo counters and accounts. Empty: the local SQLite file data/triage.sqlite3.
# Production (Neon, the POOLED connection string): postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# The server never migrates Postgres itself: run `venv/bin/alembic upgrade head` before each deploy
DATABASE_URL=
# Optional: Neon's DIRECT (unpooled) connection string, used only by `alembic upgrade head`. Empty: DATABASE_URL
DATABASE_URL_UNPOOLED=
# Prepared statements: auto (default: off for a Neon "-pooler" host, which needs them off), on or off
TRIAGE_DB_PREPARED_STATEMENTS=
# Only for `pytest -m postgres`: a throwaway test database (Neon: a test branch; the tests use its direct host)
TRIAGE_TEST_DATABASE_URL=

# ---------- Public website access (all off by default) ----------
# on: chat without a Triage key is accepted: the free demo (limits in config/demo.yaml) and BYOK (X-*-Key headers)
TRIAGE_PUBLIC=off
# on: user accounts (signup, sessions, saved provider keys, account API keys, account chat; config/accounts.yaml)
TRIAGE_ACCOUNTS=off
# Encrypts saved provider keys; required when TRIAGE_ACCOUNTS=on. "id:<base64 of 32 bytes>", comma-separated:
# the first encrypts, all decrypt (rotation: "k2:<new>,k1:<old>", then scripts/rotate_provider_keys.py).
# Generate a key: python3 -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TRIAGE_ENCRYPTION_KEYS=
# Emails (Resend, https://resend.com): password reset codes and the welcome email at signup. Without both, the reset
# endpoints answer 503 and no welcome email is sent; the server and signup still work
# The API key, from resend.com/api-keys (sending access is enough)
RESEND_API_KEY=
# The sender, on a domain verified in Resend, e.g. Triage <no-reply@triage.example.com>
TRIAGE_EMAIL_FROM=
# Optional: the logo in emails, an https:// URL of a hosted PNG (36x36 shown; 72x72 for sharp screens).
# Empty, or not serving an image at startup (checked once with a HEAD request): a plain blue square
TRIAGE_EMAIL_LOGO_URL=
# The website, for the links and button in emails, e.g. https://gettriage.dev (locally http://localhost:5173).
# https:// required (http:// only for localhost). Empty: emails are sent without links, with a startup warning
TRIAGE_APP_URL=
# The public API address shown in the welcome email's code sample, e.g. https://api.gettriage.dev (a trailing /v1
# is removed). https:// required (http:// only for localhost). Empty: https://api.gettriage.dev
TRIAGE_PUBLIC_API_URL=
# on: print reset codes to the server console instead of emailing them. Local development only: refused with a
# non-SQLite DATABASE_URL, TRIAGE_PUBLIC=on, a non-localhost CORS origin or a proxy (TRIAGE_TRUSTED_PROXY_HOPS)
TRIAGE_DEV_EMAIL_LOG=off
# Browser origins allowed to call the API (comma-separated), e.g. https://triage.example.com. Empty: none
TRIAGE_CORS_ORIGINS=
# Proxies in front of the server that append to X-Forwarded-For (0 = use the connection's IP; safe locally)
TRIAGE_TRUSTED_PROXY_HOPS=0
# Replaces routing.yaml's server_providers, e.g. groq,gemini on a host that can't run Ollama. Empty: routing.yaml's
TRIAGE_SERVER_PROVIDERS=

# ---------- Local development ----------
# 1: answer with fake models (no API calls and no provider keys; keys saved by accounts aren't checked)
TRIAGE_FAKE_MODELS=0
# Fake mode's own SQLite database (it never uses DATABASE_URL). Empty: data/fake.sqlite3
TRIAGE_FAKE_DB=
# off: no response cache
TRIAGE_CACHE=on
# The response cache file. Empty: data/cache/responses.sqlite3 (fake mode: data/cache/fake_responses.sqlite3)
TRIAGE_CACHE_PATH=
# memory: keep the request log in memory instead of the database (nothing survives a restart)
TRIAGE_LOG=sql
# Request log rows (and their labels) older than this many days are deleted, once a day. A whole number above 0.
# Empty: 365. The response cache's expired answers (older than 24 hours) are deleted by the same job, hourly.
TRIAGE_REQUEST_LOG_RETENTION_DAYS=
# GET /v1/stats/public (the dashboard's Overview tab) shows figures only once a range has this many routed
# requests. A whole number above 0. Empty: 100, which production should keep; lower it locally (e.g. 1) to see
# the full Overview with little traffic.
TRIAGE_PUBLIC_STATS_MIN_REQUESTS=
# With public access on, the web chat reads back a keyless request's cost (e.g. a stopped answer's estimate) by its
# id, without a key, for this many minutes after the request. A number above 0. Empty: 10.
TRIAGE_KEYLESS_LOOKUP_MINUTES=
# The embedding model must already be in the local Hugging Face cache; the server sets this to 1 itself
HF_HUB_OFFLINE=1
# Threads the embedding model uses. Empty: 1 (each thread keeps its own working memory)
TRIAGE_EMBEDDING_THREADS=

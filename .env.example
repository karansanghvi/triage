# Cloud providers (free tiers)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Paid providers (optional, only for the final benchmark)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local models
OLLAMA_BASE_URL=http://localhost:11434/v1

TRIAGE_HASH_SECRET=generate-with-python-secrets-token-hex-32
TRIAGE_API_KEYS=your-triage-key
TRIAGE_ADMIN_KEYS=your-admin-key
# Public website access (Phase 5). All off / empty by default.
# on: chat requests without a Triage key are accepted: the free demo (no provider keys, limits in config/demo.yaml)
# and BYOK (X-OpenAI-Key, X-Anthropic-Key, X-Groq-Key, X-Gemini-Key)
TRIAGE_PUBLIC=off
# Browser origins allowed to call the API (comma-separated), e.g. https://triage.example.com
TRIAGE_CORS_ORIGINS=
# Proxies in front of the server that append to X-Forwarded-For (0 = use the connection's IP; safe locally)
TRIAGE_TRUSTED_PROXY_HOPS=0
# Replaces routing.yaml's server_providers, e.g. groq,gemini on a host that can't run Ollama
TRIAGE_SERVER_PROVIDERS=
# Demo usage counters (default data/demo/usage.sqlite3)
TRIAGE_DEMO_DB=
